# Liszt configuration, for local development. EVERY variable is optional and
# there is no secret: the app has no auth, no sessions and no credentials, and
# the deployed service is public by design. Copy to .env to override a default.
#
# Production does not read this file. render.yaml carries the deployed values,
# and they are the ones that matter.
#
# Booleans are parsed strictly: 1/true/yes/on and 0/false/no/off. Anything else
# is a startup error naming the variable, because the old "anything that is not
# literally true is false" rule turned a typo like `LISZT_BOOT_SYNC=treu` into a
# silent default - the process looks healthy and quietly does less than it was
# configured to.

# ---------------------------------------------------------------- tube ladder
# Duration band, applied identically on every rung. Measured over the 46 links
# the live service held on 2026-09-30: of 46 winners, 26 matched the scene's
# duration exactly, 9 were 1s out and 11 were 2s out - and all 20 of those were
# the WRONG video, with none of them naming the performer. Every winner that did
# name the performer was an exact match. So 1s keeps every correct link and
# drops the off-by-one shell. `npm run calibrate` re-measures this; see
# `MATCH_DURATION_TOLERANCE_SEC` in src/core/matching.ts.
LISZT_MATCH_DURATION_TOLERANCE_SEC=1
# Upload window, in days, measured from the scene's release date. The lower
# bound is fixed at release - 1 day (pre-release leaks exist) and is not a
# knob. Both bounds are whole calendar days, compared in UTC.
# This is a starting point, not a finding: `npm run calibrate` reports the lag
# histogram it should be read against. Above ~21 days the rule stops doing
# useful work and should be deleted rather than tuned.
LISZT_MATCH_DATE_WINDOW_DAYS=7
# Drift-correction cadence: a full profile re-walk corrects deletions.
LISZT_POOL_FULL_REWALK_DAYS=7
# Comma-separated eporner accounts forming the trusted pool.
LISZT_TRUSTED_UPLOADERS=BigPussy86,thor1488,xdf1xd,patronp1987,WherbetAguiar,trainwrecx,Chicocunha420,prehistorique,mjalucard,moskvitch,brethrenm00n015,Ben670,wmartos,diggler888,rafellino,rogerrfd,Rajshot,strangerdanger13,avmatome,Ivel44,Zoloperno,Leon99,XINTERX,TwitchXX,McCreepin,Vovick17,KJUIUI,Rafael12021988,wmrt0s

# ---------------------------------------------------------------- runtime
PORT=3000
# The bind address. Loopback by default: nothing should reach the port directly
# unless something else is fronting it. render.yaml overrides this to 0.0.0.0
# because Render's proxy does need a routable interface.
# LISZT_LISTEN_ADDR=127.0.0.1
LISZT_DB_PATH=data/liszt.db
# Rolling window, in days.
LISZT_WINDOW_DAYS=90
# Source poll cadence, in minutes.
LISZT_POLL_INTERVAL_MINUTES=30
# Sync once after listen, in the background.
LISZT_BOOT_SYNC=true
# Bound the fan-out of outbound fetches and the per-request timeout.
LISZT_FETCH_CONCURRENCY=4
LISZT_FETCH_TIMEOUT_MS=15000
# Per-call deadline for the optional sxyprn source, counted from the moment the
# call reaches the front of its queue. The source paces itself at one request
# every 10s, and that wait is not part of this number.
LISZT_SXYPRN_TIMEOUT_MS=15000

# ---------------------------------------------------------------- sources
# traxxx.me politeness bounds: request spacing and per-run response cache.
LISZT_TRAXXX_MIN_INTERVAL_MS=250
LISZT_TRAXXX_CACHE_TTL_MS=300000
# Comma-separated Traxxx listing URLs. Setting this replaces the built-in
# Vixen and Bang anal watchlist; leaving it unset or empty keeps the default.
# LISZT_TRAXXX_WATCHLIST=https://traxxx.me/network/vixen/scenes/latest/1?tags=anal,https://traxxx.me/network/bang/scenes/latest/1?tags=anal
# madouqu.com is behind a Cloudflare challenge, so the WordPress.com mirror is
# the default. From some egress IPs the direct /wp-json works:
#   LISZT_MADOUQU_API_BASE=https://madouqu.com/wp-json/wp/v2
# Public ManyVids stores: Maximo by default. Add Filou Fitt with
# LISZT_MANYVIDS_STORE_IDS=1003095958,1008105753
# Explicitly empty disables ManyVids. Full pull on first use and every 7 days.
LISZT_MANYVIDS_STORE_IDS=1003095958
LISZT_MANYVIDS_MIN_INTERVAL_MS=400

# ---------------------------------------------------------------- diagnostics
# JSON-line logs to stderr. The CLI entry points set this so their stdout stays
# a single parseable result document.
LISZT_LOG_STDERR=false
