# Liszt configuration. Every variable is optional except LISZT_AUTH_PASSWORD_HASH,
# which is REQUIRED in production (NODE_ENV=production). Copy to .env and fill in.

# ---------------------------------------------------------------- auth (required)
# Generate with: npm run auth:hash  (masked prompt; the password never reaches
# shell history). Format: scrypt$N$r$p$<salt-b64>$<hash-b64>
LISZT_AUTH_PASSWORD_HASH=
# Local development only. NEVER set this on the VPS - it disables the only
# perimeter this app has.
LISZT_AUTH_DISABLED=false
# Sliding session lifetime.
LISZT_SESSION_TTL_DAYS=30
# Per-IP lockout on POST /login. The counter is consulted BEFORE any scrypt
# work, because scrypt is deliberately CPU-expensive.
LISZT_LOGIN_MAX_FAILURES=10
LISZT_LOGIN_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------- tube ladder
# Duration band, applied identically on every rung. Measured: a live matched
# pair read 2407s vs 2408s, so 2s holds one second of re-encode drift.
LISZT_MATCH_DURATION_TOLERANCE_SEC=2
# Upload window, in days, measured from the scene's release date. The lower
# bound is fixed at release - 1 day (pre-release leaks exist) and is not a
# knob. Both bounds are whole calendar days, compared in UTC.
# This is a starting point, not a finding: `npm run calibrate` reports the lag
# histogram it should be read against. Above ~21 days the rule stops doing
# useful work and should be deleted rather than tuned.
LISZT_MATCH_DATE_WINDOW_DAYS=7
# Drift-correction cadence: a full profile re-walk corrects deletions.
LISZT_POOL_FULL_REWALK_DAYS=7
# eporner open-search low-quality filter. The API defaults to lq=1, which
# INCLUDES low-quality content; 0 excludes it.
LISZT_EPORNER_LQ=0
# Comma-separated eporner accounts forming the trusted pool.
LISZT_TRUSTED_UPLOADERS=Vovick17,KJUIUI,Rafael12021988,wmrt0s

# ---------------------------------------------------------------- runtime
PORT=3000
# The bind address. Loopback by design: production is fronted by a Cloudflare
# Tunnel, so nothing needs to reach the port directly. Override ONLY for a
# platform that fronts the process with its own proxy (see render.yaml).
# LISZT_LISTEN_ADDR=127.0.0.1
LISZT_DB_PATH=data/liszt.db
# Rolling window, in days.
LISZT_WINDOW_DAYS=90
# Source poll cadence, in minutes.
LISZT_POLL_INTERVAL_MINUTES=30
# Sync once after listen, in the background.
LISZT_BOOT_SYNC=true
# Bound the fan-out of outbound fetches and the per-request timeout.
LISZT_FETCH_CONCURRENCY=4
LISZT_FETCH_TIMEOUT_MS=15000
# Per-call deadline for the optional sxyprn source.
LISZT_SXYPRN_TIMEOUT_MS=15000

# ---------------------------------------------------------------- sources
# traxxx.me politeness bounds: request spacing and per-run response cache.
LISZT_TRAXXX_MIN_INTERVAL_MS=250
LISZT_TRAXXX_CACHE_TTL_MS=300000
# madouqu.com is behind a Cloudflare challenge, so the WordPress.com mirror is
# the default. On a VPS with stable egress the direct /wp-json may work:
#   LISZT_MADOUQU_API_BASE=https://madouqu.com/wp-json/wp/v2
# The direct-scrape lane (Bang! Originals) needs no configuration.
# Maximo Garcia has no upstream listing in either reference repo; set a
# JSON-LD listing URL to enable it, or the source reports "not configured".
#   LISZT_MAXIMO_LISTING_URL=

# ---------------------------------------------------------------- diagnostics
# JSON-line logs to stderr. The CLI entry points set this so their stdout stays
# a single parseable result document.
LISZT_LOG_STDERR=false
