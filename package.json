{
  "name": "liszt",
  "version": "1.0.0",
  "private": true,
  "description": "A long-running personal release watchlist: poll sources, keep a rolling window in SQLite, resolve one verified playback link per scene or none",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test test/**/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "node --watch --env-file-if-exists=.env src/app.ts",
    "start": "node --env-file-if-exists=.env src/app.ts",
    "calibrate": "node --env-file-if-exists=.env src/cli/calibrate.ts",
    "auth:hash": "node --env-file-if-exists=.env src/cli/hash-password.ts",
    "build:docker": "docker build -t liszt ."
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "sxyprn": "^0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "prettier": "^3.4.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.18.1"
  }
}
