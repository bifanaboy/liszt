{
  "name": "liszt",
  "version": "1.0.0",
  "private": true,
  "description": "A rolling release catalogue with provider provenance and verified playback links",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test 'test/**/*.test.ts' 'test/**/*.test.js'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "calibrate": "node --env-file-if-exists=.env src/cli/calibrate.ts",
    "discover-uploaders": "node --env-file-if-exists=.env src/cli/uploader-discovery.ts",
    "catalogue-coverage": "node --env-file-if-exists=.env src/cli/catalogue-coverage.ts",
    "link-studios": "node --env-file-if-exists=.env src/cli/link-studios.ts"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "prettier": "^3.4.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.18.1"
  }
}
